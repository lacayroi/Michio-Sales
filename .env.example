NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://michio:michio@localhost:5432/michio_sales
REDIS_URL=redis://localhost:6379
SESSION_SECRET=change-me
ENCRYPTION_KEY=base64-32-bytes
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=michio-sales
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
SMTP_URL=smtp://user:pass@smtp.example.com:587
MAIL_FROM="Michio Sales Hub <no-reply@michiovietnam.com>"

# Facebook / Meta
FB_APP_ID=
FB_APP_SECRET=
FB_VERIFY_TOKEN=
FB_GRAPH_VERSION=           # trống = v26.0 (bản hiện hành 17/10/2026, xem DECISIONS D-028)

# Zalo Bot (nội bộ)
ZALO_BOT_TOKEN=
ZALO_BOT_WEBHOOK_SECRET=     # 8–256 ký tự, gửi kèm setWebhook; Zalo trả lại trong header X-Bot-Api-Secret-Token
ZALO_BOT_POLLING=false       # true: dùng getUpdates thay webhook (máy chưa có HTTPS công khai)

# WooCommerce (quyền Read)
WOO_BASE_URL=https://michiovietnam.com
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=
WOO_WEBHOOK_SECRET=

# Zalo công ty chế độ B (tắt mặc định)
FEATURE_ZALO_COMPANY_GATEWAY=false

# Zalo OA (chưa dùng)
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_OA_SECRET_KEY=

MOCK_INTEGRATIONS=true
SENTRY_DSN=
TZ=Asia/Ho_Chi_Minh
