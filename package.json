{
  "name": "michio-sales-hub",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @michio/web test:e2e",
    "db:migrate": "pnpm --filter @michio/db migrate",
    "db:deploy": "pnpm --filter @michio/db run deploy",
    "db:seed": "pnpm --filter @michio/db seed",
    "db:reset": "pnpm --filter @michio/db reset",
    "infra:up": "docker compose up -d postgres redis s3",
    "replay:webhook": "pnpm --filter @michio/worker replay:webhook"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^15.5.28",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^3.2.7",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "turbo": "^2.11.8",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^3.2.7"
  }
}
